</style>

@code {
    Portfolio? portfolio;
    DesignSetting? design;
    Section? activeSection;

    bool addingSectionMode = false;
    string newSectionTitle = string.Empty;

    // Следим за каким блоком идёт загрузка файла
    int? uploadingBlockId = null;

    bool initialized = false;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (!Session.IsLoggedIn)
            {
                Navigation.NavigateTo("/");
                return;
            }
            portfolio = DbService.GetOrCreatePortfolio(Session.CurrentUserId);
            design = portfolio.DesignSetting;
            activeSection = portfolio.Sections.FirstOrDefault();
            initialized = true;
            StateHasChanged(); // перерисовать с данными
        }
    }

    void SelectSection(Section sec)
    {
        activeSection = sec;
    }

    // ===== Разделы =====

    void ConfirmAddSection()
    {
        if (string.IsNullOrWhiteSpace(newSectionTitle) || portfolio == null) return;
        DbService.AddCustomSection(portfolio.Id, newSectionTitle);
        Reload(selectLast: true);
        newSectionTitle = string.Empty;
        addingSectionMode = false;
    }

    void DeleteSection(Section sec)
    {
        if (!sec.IsCustom) return;
        DbService.DeleteSection(sec.Id);
        Reload(selectLast: false);
    }

    // ===== Блоки =====

    void AddBlock(string type)
    {
        if (activeSection == null) return;
        DbService.AddBlock(activeSection.Id, type, string.Empty);
        ReloadSection();
    }

    void SaveBlock(Block block)
    {
        DbService.UpdateBlock(block);
    }

    void DeleteBlock(Block block)
    {
        DbService.DeleteBlock(block.Id);
        ReloadSection();
    }

    // Загрузка фото — async, потому что работаем с файлом
    async Task UploadImage(InputFileChangeEventArgs e, Block block)
    {
        uploadingBlockId = block.Id;
        StateHasChanged();

        var file = e.File;
        var path = await DbService.SaveImageAsync(file);

        block.Content = path;
        DbService.UpdateBlock(block);

        uploadingBlockId = null;
        ReloadSection();
    }

    // ===== Дизайн =====

    void SaveDesign()
    {
        if (design != null)
            DbService.UpdateDesign(design);
    }

    // ===== Навигация =====

    void GoToView()   => Navigation.NavigateTo("/view");
    void Logout()     { Session.Logout(); Navigation.NavigateTo("/"); }

    // ===== Вспомогательное =====

    void Reload(bool selectLast)
    {
        var prevId = activeSection?.Id;
        portfolio = DbService.GetOrCreatePortfolio(Session.CurrentUserId);
        design = portfolio.DesignSetting;
        activeSection = selectLast
            ? portfolio.Sections.LastOrDefault()
            : portfolio.Sections.FirstOrDefault(s => s.Id == prevId)
              ?? portfolio.Sections.FirstOrDefault();
    }

    void ReloadSection()
    {
        var prevId = activeSection?.Id;
        portfolio = DbService.GetOrCreatePortfolio(Session.CurrentUserId);
        design = portfolio.DesignSetting;
        activeSection = portfolio.Sections.FirstOrDefault(s => s.Id == prevId);
    }

    string BlockTypeLabel(string type) => type switch
    {
        "text"  => "📝 Текст",
        "image" => "🖼 Изображение",
        "link"  => "🔗 Ссылка",
        _       => type
    };
}
